# Copy this file to `.env` and fill in the values from your own Firebase project.
#
#   cp .env.example .env
#
# `.env` is listed in .gitignore, so it never gets committed.
#
# Where to find these values:
#   Firebase console > Project settings > Your apps > Web app > SDK setup
#
# IMPORTANT - these are NOT secrets.
# Any variable whose name starts with EXPO_PUBLIC_ is inlined into the JavaScript
# bundle by Expo, so anybody who has the app can read these values. That is
# expected and it is safe: Firebase web config values are designed to be public.
# What actually protects your data is Firebase Authentication (which owns the
# passwords) plus the Firestore security rules in firestore.rules.
# Never put a service account key or any admin credential in this file or in
# the app.

EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key-here
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
EXPO_PUBLIC_FIREBASE_APP_ID=your-app-id
